{
  "name": "@homeslate/editor",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeslate/homeslate-oss.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig ../../tsconfig.app.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@homeslate/display": "*",
    "@homeslate/schema": "*",
    "@homeslate/widgets": "*",
    "@mantine/core": "^8.3.10",
    "@tabler/icons-react": "^3.35.0",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
