{
  "name": "@homeslate/adapters",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeslate/homeslate-oss.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@homeslate/google": "*",
    "@homeslate/schema": "*",
    "@homeslate/widgets": "*",
    "uuid": "^13.0.0"
  }
}
