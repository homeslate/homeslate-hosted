# Google OAuth Client ID (from Google Cloud Console)
# Used by the frontend for Sign In with Google
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Same Google Client ID used by Netlify Functions to verify tokens server-side
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Google OAuth Client Secret (from Google Cloud Console)
# Required for server-side token refresh
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Find your OAuth 2.0 Client ID
# 3. Click the client to see its details
# 4. Copy the "Client secret" value
GOOGLE_CLIENT_SECRET=your_client_secret

# Neon PostgreSQL connection string (from Neon dashboard)
# For local development, use the "dev" branch connection string
# For production, use the "main" branch connection string
# These are set via Netlify environment variable context scoping for deployed envs
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional local override used by:
#   npm run db:migrate:prod
# This lets you run prod migrations explicitly without replacing DATABASE_URL.
DATABASE_URL_PROD=postgresql://user:password@host/dbname?sslmode=require

# Stripe billing (Phase B). Use test-mode keys until production cutover.
# See docs/superpowers/specs/2026-09-03-hosted-billing-stripe-setup.md
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
BILLING_SUCCESS_URL=https://homeslate.dev/displays?upgraded=1
BILLING_CANCEL_URL=https://homeslate.dev/displays
VITE_BILLING_ENABLED=true
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_ANNUAL=price_...

# Optional error monitoring (Sentry). Leave unset to disable.
# Create a project at https://sentry.io — use the same DSN for both vars.
SENTRY_DSN=
VITE_SENTRY_DSN=
