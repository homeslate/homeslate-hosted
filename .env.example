# Google OAuth Client ID (from Google Cloud Console)
# Used by the frontend for Sign In with Google
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Same Google Client ID used by Netlify Functions to verify tokens server-side
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Google OAuth Client Secret (from Google Cloud Console)
# Required for server-side token refresh
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Find your OAuth 2.0 Client ID
# 3. Click the client to see its details
# 4. Copy the "Client secret" value
GOOGLE_CLIENT_SECRET=your_client_secret

# Neon PostgreSQL connection string (from Neon dashboard)
# For local development, use the "dev" branch connection string
# For production, use the "main" branch connection string
# These are set via Netlify environment variable context scoping for deployed envs
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
